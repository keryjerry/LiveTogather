rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// 1. users/{userId}
//    - Document ID: Firebase Auth UID
//    - Fields: uid (string), userId (8-digit string), name (string), email (string),
//              isAdmin (bool, privileged/restricted), officialRole (string, privileged/restricted),
//              activeFrame (string), ownedFrames (list), activeMicEffect (string), ownedMicEffects (list),
//              diamonds (int/float), coins (int/float), wealthLevel (int), wealthXp (int),
//              charmLevel (int), charmXp (int), pkLevel (int), pkWins (int), pkScore (int),
//              isSuspended (bool, privileged/restricted), suspensionExpiry (int), suspensionReason (string), etc.
//    - Whitelisted Admin & Founder Emails: 'service.secure822@gmail.com', 'servicesecure822@gmail.com', 'devilgroupcontact@gmail.com'
//
// 2. users/{userId}/followers/{followerId}
//    - Document ID: Follower user UID
//    - Fields: uid (string), followedAt (timestamp/number), etc.
//
// 3. payment_requests/{reqId}
//    - Document ID: Auto-generated or custom request ID
//    - Fields: userId (string), amount (number), utr (string), status (string), etc.
//
// 4. admin_notifications/{notifId}
//    - Document ID: Notification ID
//    - Fields: title (string), message (string), targetUid (string), createdAt (timestamp/number)
//
// 5. reports/{reportId}
//    - Document ID: Auto-generated report ID
//    - Fields: reportedBy (string), targetUid (string), reason (string), details (string)
//
// 6. rooms/{roomId}
//    - Document ID: Room ID
//    - Fields: hostUid / hostId (string), title (string), category (string),
//              adminUserIds (list of strings), isLive (bool), etc.
//
// 7. rooms/{roomId}/mic_seats/{seatId}
//    - Document ID: Seat index (0-7)
//    - Fields: seatIndex (int), occupantUid (string), isMuted (bool), isLocked (bool)
//
// 8. rooms/{roomId}/live_comments/{commentId}
//    - Document ID: Comment ID
//    - Fields: userId (string), text (string), timestamp (number/timestamp)
//
// 9. rooms/{roomId}/gift_events/{eventId}
//    - Document ID: Event ID
//    - Fields: id (string), roomId (string), senderId (string, == auth.uid), senderName (string),
//              senderPhoto (string), giftId (string), giftName (string), giftEmoji (string),
//              cost (number >= 0), animationType (string), timestamp (int), targetUserId (string),
//              targetUserName (string), quantity (int), receiverUserIds (list), receiverNames (list)
//
// 10. matches/{matchId}
//     - Document ID: Match ID (usually sorted user UIDs)
//     - Fields: users (list of 2 strings: UIDs), matchedAt (timestamp/number), etc.
//
// 11. chats/{chatId}
//     - Document ID: Chat conversation ID
//     - Fields: participants (list of strings: UIDs), lastMessage (string), updatedAt
//
// 12. chats/{chatId}/messages/{msgId}
//     - Document ID: Message ID
//     - Fields: senderId (string), text (string), timestamp (timestamp/number), mediaUrl (string)
//
// 13. moments/{momentId}
//     - Document ID: Moment ID
//     - Fields: userId (string), caption (string), mediaUrls (list), createdAt
//
// 14. swipes/{swipeId}
//     - Document ID: Swipe record ID (e.g., swiperId_swipedId)
//     - Fields: userId (string), targetUserId (string), direction (string), timestamp
//
// 15. intimacy_bonds/{bondId}
//     - Document ID: Bond ID (e.g., user1_user2)
//     - Fields: user1Id (string), user2Id (string), level (int), intimacyScore (int)
//
// 16. intent_categories/{catId}
//     - Document ID: Category slug/ID
//     - Fields: name (string), iconUrl (string), activeRoomsCount (int)
//
// 17. claimed_devices/{deviceId} & claimed_ips/{ip}
//     - Document ID: Sanitized Device UUID or IP Address
//     - Fields: uid (string), claimedAt (timestamp/number), deviceModel (string)
//
// 18. users/{userId}/profile_visitors/{visitorId}
//     - Document ID: Visitor Firebase Auth UID
//     - Fields: visitorUid (string, required, immutable), visitorName (string, required, <=120),
//               visitorPhoto (string, optional, <=2048), visitorVipLevel (int, optional, 0..10),
//               visitedAt (int, required, >0)
//
// 19. users/{userId}/received_gifts/{giftId}
//     - Document ID: Gift transaction/event ID
//     - Fields: id (string, optional), giftId (string, required, immutable), giftName (string, optional),
//               giftEmoji (string, optional), quantity (int, optional, 1..10000), cost (number, required, >=0, immutable),
//               diamondValue (number, optional, >=0), senderId (string, required, immutable),
//               senderUid (string, optional), senderName (string, optional), senderPhoto (string, optional),
//               receiverId (string, required, immutable), roomId (string, optional), timestamp (int, required, immutable)
//
// 20. official_events/{eventId} & official_events/{eventId}/reminders/{uid}
//     - Event Document ID: Event UUID
//     - Event Fields: id (string, optional), title (string, required, 1..200), hostUid (string, required, immutable),
//                     hostName (string, optional), hostPhotoUrl (string, optional), roomType (string, optional: audio|video),
//                     eventThemeStyle (string, optional), status (string, required: UPCOMING|LIVE|ENDED|CANCELLED),
//                     scheduledStartAt (int, optional, >0), createdAt (int, required, immutable), roomId (string, optional)
//     - Reminder Document ID: Subscriber Firebase Auth UID
//     - Reminder Fields: uid (string, required, immutable), name (string, optional), at (int, required, >0)
//
// 21. rooms/{roomId}/event_leaderboard/{uid}
//     - Document ID: Supporter Firebase Auth UID
//     - Fields: uid (string, required, immutable), name (string, required, 1..120), photo (string, optional, <=2048),
//               totalDiamonds (number, required, >=0), giftCount (int, required, >=0), updatedAt (int, required, >0)
//
// 22. users/{userId}/gift_earnings_history/{histId}
//     - Document ID: Notification/History UUID
//     - Fields: id (string), targetUserId (string), senderId (string, == auth.uid), senderName (string),
//               senderPhoto (string), giftId (string), giftName (string), giftEmoji (string), quantity (int),
//               grossDiamonds (number), creatorDiamonds (number), commissionPercent (number), earningsInr (number),
//               timestamp (int), roomId (string)
//
// 23. rooms/{roomId}/games/{gameId} & rooms/{roomId}/emoji_reactions/{reactionId}
//     - Real-time in-room multiplayer games (Carrom, Ludo) and live emoji reaction streams
//
// 24. intimacy_requests/{requestId}
//     - Document ID: Request UUID
//     - Fields: senderUid (string, required, immutable), recipientUid (string, required, immutable),
//               roomId (string), status (string), bondType (string), timestamp (int)
//
// 25. intent_categories/{catId}/rooms/{roomId} & .../members/{memberId}
//     - Category-indexed live rooms and active member presence documents
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the current user is the owner of the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function checking if user's verified token email matches the founder/admin whitelist
    function isWhitelistedAdminEmail() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        (
          request.auth.token.email in [
            'service.secure822@gmail.com',
            'servicesecure822@gmail.com',
            'devilgroupcontact@gmail.com',
            'Service.secure822@gmail.com',
            'Servicesecure822@gmail.com',
            'Devilgroupcontact@gmail.com',
            'SERVICE.SECURE822@GMAIL.COM',
            'SERVICESECURE822@GMAIL.COM',
            'DEVILGROUPCONTACT@GMAIL.COM'
          ]
        );
    }

    // Check if user has administrative rights via:
    // 1. Explicit hardcoded founder/admin emails whitelist:
    //    'service.secure822@gmail.com', 'servicesecure822@gmail.com', 'devilgroupcontact@gmail.com'
    // 2. Firebase Auth custom claim `admin == true`
    // 3. Existence and flag in `admin_whitelists` collection (with @ replaced with _at_)
    // 4. User document flag `isAdmin == true` or official leadership role ('founder', 'ceo')
    function isAdmin() {
      return isAuthenticated() && (
        isWhitelistedAdminEmail() ||
        (request.auth.token.get('admin', false) == true) ||
        (
          'email' in request.auth.token &&
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/admin_whitelists/$(request.auth.token.email.replace('@', '_at_'))) &&
          get(/databases/$(database)/documents/admin_whitelists/$(request.auth.token.email.replace('@', '_at_'))).data.get('isAdmin', false) == true
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('officialRole', '') in ['founder', 'ceo']
          )
        )
      );
    }

    // Check if the current user has official administrative rights either globally via isAdmin(),
    // or as the owner of this profile having administrative / leadership flags (isAdmin == true, officialRole in ['founder', 'ceo'])
    function hasOfficialAdminRights(userId) {
      return isAdmin() || (
        isOwner(userId) && resource != null && (
          resource.data.get('isAdmin', false) == true ||
          resource.data.get('officialRole', '') in ['founder', 'ceo']
        )
      );
    }

    // Validate that immutable fields are not modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function hasNoSelfGrantedEntitlements() {
      return request.resource.data.get('plan', 'Free') == 'Free' &&
        request.resource.data.get('vipLevel', 0) == 0 &&
        request.resource.data.get('isHostMonetized', false) == false &&
        request.resource.data.get('hostMonetizationDate', 0) == 0 &&
        request.resource.data.get('activeFrame', '') == '' &&
        request.resource.data.get('activeChatFrame', '') == '' &&
        !request.resource.data.get('ownedFrames', []).hasAny([
          'vip_suite_frame_1',
          'vip_suite_frame_2',
          'vip_suite_frame_3',
          'vip_suite_frame_4'
        ]) &&
        !request.resource.data.get('ownedChatFrames', []).hasAny([
          'chat_frame_silver_knight',
          'chat_frame_golden_paladin',
          'chat_frame_imperial_amethyst',
          'chat_frame_celestial_dragon'
        ]);
    }

    function hasApprovedVipLevel(level) {
      return request.resource.data.get('vipLevel', 0) >= level ||
        (
          level == 1 &&
          request.resource.data.get('plan', '') in ['VIP 1', 'VIP 2', 'VIP 3', 'VIP 4']
        ) ||
        (
          level == 2 &&
          request.resource.data.get('plan', '') in ['VIP 2', 'VIP 3', 'VIP 4']
        ) ||
        (
          level == 3 &&
          request.resource.data.get('plan', '') in ['VIP 3', 'VIP 4']
        ) ||
        (
          level == 4 &&
          request.resource.data.get('plan', '') == 'VIP 4'
        );
    }

    function mayEquipVipFrame() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'activeFrame',
        'activeChatFrame',
        'activeChatBar',
        'activeProfileArch',
        'activeProfileCover',
        'activeEntranceEffect',
        'ownedFrames',
        'ownedChatFrames'
      ]) || (
      (
        request.resource.data.get('activeFrame', '') != 'vip_suite_frame_1' ||
        hasApprovedVipLevel(1)
      ) && (
        request.resource.data.get('activeFrame', '') != 'vip_suite_frame_2' ||
        hasApprovedVipLevel(2)
      ) && (
        request.resource.data.get('activeFrame', '') != 'vip_suite_frame_3' ||
        hasApprovedVipLevel(3)
      ) && (
        request.resource.data.get('activeFrame', '') != 'vip_suite_frame_4' ||
        hasApprovedVipLevel(4)
      ) && (
        request.resource.data.get('activeChatFrame', '') != 'chat_frame_silver_knight' ||
        hasApprovedVipLevel(1)
      ) && (
        request.resource.data.get('activeChatFrame', '') != 'chat_frame_golden_paladin' ||
        hasApprovedVipLevel(2)
      ) && (
        request.resource.data.get('activeChatFrame', '') != 'chat_frame_imperial_amethyst' ||
        hasApprovedVipLevel(3)
      ) && (
        request.resource.data.get('activeChatFrame', '') != 'chat_frame_celestial_dragon' ||
        hasApprovedVipLevel(4)
      ) && (
        (
          request.resource.data.get('activeChatBar', '') != 'chat_sword_vip_1' &&
          request.resource.data.get('activeProfileArch', '') != 'arch_vip_1' &&
          request.resource.data.get('activeProfileCover', '') != 'cover_vip_1' &&
          request.resource.data.get('activeEntranceEffect', '') != 'entrance_vip_1'
        ) ||
        hasApprovedVipLevel(1)
      ) && (
        (
          request.resource.data.get('activeChatBar', '') != 'chat_sword_vip_2' &&
          request.resource.data.get('activeProfileArch', '') != 'arch_vip_2' &&
          request.resource.data.get('activeProfileCover', '') != 'cover_vip_2' &&
          request.resource.data.get('activeEntranceEffect', '') != 'entrance_vip_2'
        ) ||
        hasApprovedVipLevel(2)
      ) && (
        (
          request.resource.data.get('activeChatBar', '') != 'chat_sword_vip_3' &&
          request.resource.data.get('activeProfileArch', '') != 'arch_vip_3' &&
          request.resource.data.get('activeProfileCover', '') != 'cover_vip_3' &&
          request.resource.data.get('activeEntranceEffect', '') != 'entrance_vip_3'
        ) ||
        hasApprovedVipLevel(3)
      ) && (
        (
          request.resource.data.get('activeChatBar', '') != 'chat_sword_vip_4' &&
          request.resource.data.get('activeProfileArch', '') != 'arch_vip_4' &&
          request.resource.data.get('activeProfileCover', '') != 'cover_vip_4' &&
          request.resource.data.get('activeEntranceEffect', '') != 'entrance_vip_4'
        ) ||
        hasApprovedVipLevel(4)
      ) && (
        !request.resource.data.get('ownedFrames', []).hasAny(['vip_suite_frame_1']) ||
        hasApprovedVipLevel(1)
      ) && (
        !request.resource.data.get('ownedFrames', []).hasAny(['vip_suite_frame_2']) ||
        hasApprovedVipLevel(2)
      ) && (
        !request.resource.data.get('ownedFrames', []).hasAny(['vip_suite_frame_3']) ||
        hasApprovedVipLevel(3)
      ) && (
        !request.resource.data.get('ownedFrames', []).hasAny(['vip_suite_frame_4']) ||
        hasApprovedVipLevel(4)
      ) && (
        !request.resource.data.get('ownedChatFrames', []).hasAny([
          'chat_frame_silver_knight',
          'chat_frame_golden_paladin',
          'chat_frame_imperial_amethyst',
          'chat_frame_celestial_dragon'
        ]) ||
        (
          (!request.resource.data.get('ownedChatFrames', []).hasAny(['chat_frame_silver_knight']) || hasApprovedVipLevel(1)) &&
          (!request.resource.data.get('ownedChatFrames', []).hasAny(['chat_frame_golden_paladin']) || hasApprovedVipLevel(2)) &&
          (!request.resource.data.get('ownedChatFrames', []).hasAny(['chat_frame_imperial_amethyst']) || hasApprovedVipLevel(3)) &&
          (!request.resource.data.get('ownedChatFrames', []).hasAny(['chat_frame_celestial_dragon']) || hasApprovedVipLevel(4))
        )
      )
      );
    }

    function mayChangePlanWithoutVipGrant() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']) ||
        (
          !request.resource.data.get('plan', '').lower().matches('.*vip.*') &&
          !request.resource.data.get('plan', '').lower().matches('.*platinum.*')
        );
    }

    // Check if the current user is host or room admin
    function isRoomHostOrAdmin(roomData) {
      return isAuthenticated() && (
        roomData.get('hostUid', '') == request.auth.uid ||
        roomData.get('hostId', '') == request.auth.uid ||
        (roomData.get('adminUserIds', []).hasAny([request.auth.uid])) ||
        isAdmin()
      );
    }

    // Check if the current user is host
    function isRoomHost(roomData) {
      return isAuthenticated() && (
        roomData.get('hostUid', '') == request.auth.uid ||
        roomData.get('hostId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Domain validator for users/{userId}/profile_visitors/{visitorId}
    function isValidProfileVisitor(data, visitorId) {
      return data.keys().hasOnly([
          'visitorUid',
          'visitorName',
          'visitorPhoto',
          'visitorVipLevel',
          'visitedAt'
        ]) &&
        data.keys().hasAll(['visitorUid', 'visitorName', 'visitedAt']) &&
        data.visitorUid is string &&
        data.visitorUid == visitorId &&
        data.visitorUid.size() > 0 &&
        data.visitorUid.size() <= 128 &&
        data.visitorName is string &&
        data.visitorName.size() > 0 &&
        data.visitorName.size() <= 120 &&
        (!('visitorPhoto' in data) || (data.visitorPhoto is string && data.visitorPhoto.size() <= 2048)) &&
        (!('visitorVipLevel' in data) || (data.visitorVipLevel is int && data.visitorVipLevel >= 0 && data.visitorVipLevel <= 10)) &&
        data.visitedAt is int &&
        data.visitedAt > 0;
    }

    // Domain validator for users/{userId}/received_gifts/{giftId}
    function isValidReceivedGift(data, userId) {
      return data.keys().hasOnly([
          'id',
          'giftId',
          'giftName',
          'giftEmoji',
          'quantity',
          'cost',
          'diamondValue',
          'senderId',
          'senderUid',
          'senderName',
          'senderPhoto',
          'receiverId',
          'roomId',
          'timestamp'
        ]) &&
        data.keys().hasAll(['giftId', 'cost', 'senderId', 'receiverId', 'timestamp']) &&
        data.senderId is string &&
        data.senderId.size() > 0 &&
        data.senderId.size() <= 128 &&
        (!('senderUid' in data) || (data.senderUid is string && data.senderUid == data.senderId && data.senderUid.size() <= 128)) &&
        data.receiverId is string &&
        data.receiverId == userId &&
        data.receiverId.size() <= 128 &&
        data.giftId is string &&
        data.giftId.size() > 0 &&
        data.giftId.size() <= 128 &&
        data.cost is number &&
        data.cost >= 0 &&
        data.cost <= 100000000 &&
        (!('diamondValue' in data) || (data.diamondValue is number && data.diamondValue >= 0 && data.diamondValue <= 100000000)) &&
        (!('quantity' in data) || (data.quantity is int && data.quantity >= 1 && data.quantity <= 10000)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 256)) &&
        (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 120)) &&
        (!('giftEmoji' in data) || (data.giftEmoji is string && data.giftEmoji.size() <= 32)) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120)) &&
        (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 2048)) &&
        (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
        data.timestamp is int &&
        data.timestamp > 0;
    }

    // Domain validator for official_events/{eventId}
    function isValidOfficialEvent(data) {
      return data.keys().hasOnly([
          'id',
          'title',
          'hostUid',
          'hostName',
          'hostPhotoUrl',
          'roomType',
          'eventThemeStyle',
          'status',
          'scheduledStartAt',
          'createdAt',
          'roomId'
        ]) &&
        data.keys().hasAll(['title', 'hostUid', 'status', 'createdAt']) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200 &&
        data.hostUid is string &&
        data.hostUid.size() > 0 &&
        data.hostUid.size() <= 128 &&
        (!('hostName' in data) || (data.hostName is string && data.hostName.size() <= 120)) &&
        (!('hostPhotoUrl' in data) || (data.hostPhotoUrl is string && data.hostPhotoUrl.size() <= 2048)) &&
        (!('roomType' in data) || (data.roomType is string && data.roomType in ['audio', 'video'])) &&
        (!('eventThemeStyle' in data) || (data.eventThemeStyle is string && data.eventThemeStyle.size() <= 64)) &&
        data.status is string &&
        data.status in ['UPCOMING', 'LIVE', 'ENDED', 'CANCELLED'] &&
        (!('scheduledStartAt' in data) || (data.scheduledStartAt is int && data.scheduledStartAt > 0)) &&
        data.createdAt is int &&
        data.createdAt > 0 &&
        (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128));
    }

    // Domain validator for official_events/{eventId}/reminders/{uid}
    function isValidEventReminder(data, uid) {
      return data.keys().hasOnly(['uid', 'name', 'at']) &&
        data.keys().hasAll(['uid', 'at']) &&
        data.uid is string &&
        data.uid == uid &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        data.at is int &&
        data.at > 0;
    }

    // Domain validator for rooms/{roomId}/event_leaderboard/{uid}
    function isValidEventLeaderboardEntry(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'name',
          'photo',
          'totalDiamonds',
          'giftCount',
          'updatedAt'
        ]) &&
        data.keys().hasAll(['uid', 'name', 'totalDiamonds', 'giftCount', 'updatedAt']) &&
        data.uid is string &&
        data.uid == uid &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        (!('photo' in data) || (data.photo is string && data.photo.size() <= 2048)) &&
        data.totalDiamonds is number &&
        data.totalDiamonds >= 0 &&
        data.totalDiamonds <= 1000000000 &&
        data.giftCount is int &&
        data.giftCount >= 0 &&
        data.giftCount <= 1000000 &&
        data.updatedAt is int &&
        data.updatedAt > 0;
    }

    // Domain validator for rooms/{roomId}/gift_events/{eventId}
    function isValidRoomGiftEvent(data) {
      return data.senderId is string &&
        data.senderId == request.auth.uid &&
        data.senderId.size() > 0 &&
        data.senderId.size() <= 128 &&
        data.cost is number &&
        data.cost >= 0 &&
        data.cost <= 100000000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 256)) &&
        (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120)) &&
        (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 2048)) &&
        (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 128)) &&
        (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 120)) &&
        (!('giftEmoji' in data) || (data.giftEmoji is string && data.giftEmoji.size() <= 32)) &&
        (!('animationType' in data) || (data.animationType is string && data.animationType.size() <= 64)) &&
        (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() <= 128)) &&
        (!('targetUserName' in data) || (data.targetUserName is string && data.targetUserName.size() <= 120)) &&
        (!('quantity' in data) || (data.quantity is int && data.quantity >= 0 && data.quantity <= 10000)) &&
        (!('receiverUserIds' in data) || (data.receiverUserIds is list && data.receiverUserIds.size() <= 100)) &&
        (!('receiverNames' in data) || (data.receiverNames is list && data.receiverNames.size() <= 100)) &&
        (!('timestamp' in data) || (data.timestamp is int && data.timestamp > 0));
    }

    // Domain validator for users/{userId}/gift_earnings_history/{histId}
    function isValidGiftEarningsHistory(data, userId) {
      return data.senderId is string &&
        data.senderId == request.auth.uid &&
        data.senderId.size() > 0 &&
        data.senderId.size() <= 128 &&
        (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId == userId)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 256)) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120)) &&
        (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 2048)) &&
        (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 128)) &&
        (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 120)) &&
        (!('giftEmoji' in data) || (data.giftEmoji is string && data.giftEmoji.size() <= 32)) &&
        (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
        (!('quantity' in data) || (data.quantity is int && data.quantity >= 0 && data.quantity <= 10000)) &&
        (!('grossDiamonds' in data) || (data.grossDiamonds is number && data.grossDiamonds >= 0 && data.grossDiamonds <= 100000000)) &&
        (!('creatorDiamonds' in data) || (data.creatorDiamonds is number && data.creatorDiamonds >= 0 && data.creatorDiamonds <= 100000000)) &&
        (!('earningsInr' in data) || (data.earningsInr is number && data.earningsInr >= 0 && data.earningsInr <= 100000000)) &&
        (!('timestamp' in data) || (data.timestamp is int && data.timestamp > 0));
    }

    // ===============================================================
    // User Profiles & Followers
    // ===============================================================

    match /users/{userId} {
      // Authenticated users can view profiles
      allow read: if isAuthenticated();

      // Only the user themselves can create their profile doc (or an admin), and non-admins cannot self-promote to admin or official leadership role
      allow create: if (isOwner(userId) || isAdmin()) && (
        hasOfficialAdminRights(userId) ||
        (
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
          (!('officialRole' in request.resource.data) || request.resource.data.officialRole == '') &&
          hasNoSelfGrantedEntitlements()
        )
      );

      // Admins or users with official administrative rights can update any fields
      // (such as diamonds, coins, officialRole, activeFrame, ownedFrames, isAdmin);
      // Profile owners can update their own profile as long as non-admins do not modify privileged administrative/moderation fields;
      // Other authenticated users can update social metrics & gift reward stats (followerCount, charmXp, charmLevel, earnings, pk stats)
      allow update: if hasOfficialAdminRights(userId) ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isAdmin',
            'officialRole',
            'isSuspended',
            'suspensionExpiry',
            'suspensionReason',
            'vipLevel',
            'isHostMonetized',
            'hostMonetizationDate'
          ]) &&
          mayChangePlanWithoutVipGrant() &&
          mayEquipVipFrame()
        ) ||
        (
          isAuthenticated() &&
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'followerCount',
            'charmXp',
            'charmLevel',
            'earningsInr',
            'totalEarningsInr',
            'diamonds',
            'coins',
            'giftCount',
            'pkWins',
            'pkScore',
            'pkLevel'
          ]) &&
          (
            !('diamonds' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.diamonds is number &&
              request.resource.data.diamonds >= resource.data.get('diamonds', 0)
            )
          ) &&
          (
            !('coins' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.coins is number &&
              request.resource.data.coins >= resource.data.get('coins', 0)
            )
          )
        );

      // Deletion of user profile requires admin privileges
      allow delete: if isAdmin();

      // Followers subcollection: users/{userId}/followers/{followerId}
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == followerId);
      }

      // Following subcollection: users/{userId}/following/{followingId}
      match /following/{followingId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // User private notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAuthenticated();
      }

      // Profile Visitors subcollection: users/{userId}/profile_visitors/{visitorId}
      match /profile_visitors/{visitorId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.auth.uid == visitorId &&
          request.auth.uid != userId &&
          request.resource.data.visitorUid == request.auth.uid &&
          isValidProfileVisitor(request.resource.data, visitorId);
        allow update: if isAuthenticated() &&
          request.auth.uid == visitorId &&
          request.auth.uid != userId &&
          request.resource.data.visitorUid == request.auth.uid &&
          areImmutableFieldsUnchanged(['visitorUid']) &&
          isValidProfileVisitor(request.resource.data, visitorId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /received_gifts/{giftId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.receiverId == userId &&
          request.resource.data.giftId is string &&
          request.resource.data.cost is number &&
          request.resource.data.cost >= 0 &&
          isValidReceivedGift(request.resource.data, userId);
        allow update: if (isOwner(userId) || isAdmin()) &&
          areImmutableFieldsUnchanged(['senderId', 'receiverId', 'giftId', 'cost', 'timestamp']) &&
          isValidReceivedGift(request.resource.data, userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User coin & earning transaction ledgers
      match /coin_transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /earning_transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // Creator Gift Earnings History subcollection
      match /gift_earnings_history/{histId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          isValidGiftEarningsHistory(request.resource.data, userId);
        allow update, delete: if isAdmin();
      }
    }

    // ===============================================================
    // Payment Requests & Financial Operations
    // ===============================================================

    match /payment_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('purchaseType', '') in ['coins', 'vip', 'host_monetization'] &&
        (
          request.resource.data.get('purchaseType', '') != 'vip' ||
          request.resource.data.get('vipLevel', 0) in [1, 2, 3, 4]
        ) &&
        request.resource.data.keys().hasOnly([
          'requestId',
          'userId',
          'userNumericId',
          'userName',
          'utrNumber',
          'coinsRequested',
          'amountPaid',
          'status',
          'category',
          'message',
          'purchaseType',
          'vipLevel',
          'timestamp'
        ]);
      allow update: if isAdmin() &&
        request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /withdrawal_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Admin Notifications & Whitelists
    // ===============================================================

    match /admin_notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /admin_whitelists/{emailDoc} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // User Reports & Support
    // ===============================================================

    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ===============================================================
    // Rooms & Interactive Live Hangouts
    // ===============================================================

    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.get('hostUid', '') == request.auth.uid ||
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('adminUserIds', []).hasAny([request.auth.uid]) ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pkHost1Score',
            'pkHost2Score',
            'activeUserCount',
            'roomFollowerCount',
            'roomActivityXp',
            'roomLevel'
          ]) &&
          (
            !('pkHost1Score' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.pkHost1Score is number &&
              request.resource.data.pkHost1Score >= resource.data.get('pkHost1Score', 0)
            )
          ) &&
          (
            !('pkHost2Score' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.pkHost2Score is number &&
              request.resource.data.pkHost2Score >= resource.data.get('pkHost2Score', 0)
            )
          ) &&
          (
            !('activeUserCount' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.activeUserCount is int &&
              request.resource.data.activeUserCount >= 0
            )
          ) &&
          (
            !('roomFollowerCount' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.roomFollowerCount is int &&
              request.resource.data.roomFollowerCount >= 0
            )
          ) &&
          (
            !('roomActivityXp' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.roomActivityXp is number &&
              request.resource.data.roomActivityXp >= resource.data.get('roomActivityXp', 0)
            )
          ) &&
          (
            !('roomLevel' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              request.resource.data.roomLevel is int &&
              request.resource.data.roomLevel >= resource.data.get('roomLevel', 1)
            )
          )
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.get('hostUid', '') == request.auth.uid ||
        resource.data.get('hostId', '') == request.auth.uid ||
        isAdmin()
      );

      // Mic Seats in Room
      match /mic_seats/{seatId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Live Comments in Room
      match /live_comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // Gift Events in Room
      match /gift_events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.cost >= 0 &&
          isValidRoomGiftEvent(request.resource.data);
        allow update, delete: if isAdmin();
      }

      // Real-time In-Room Games (Carrom & Ludo multiplayer sync)
      match /games/{gameId} {
        allow read, write: if isAuthenticated();
      }

      // Live Emoji Reactions in Room
      match /emoji_reactions/{reactionId} {
        allow read, write: if isAuthenticated();
      }

      // Active Room Members
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Video Stage Requests
      match /stage_requests/{reqId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Video Hangout Invites
      match /video_invites/{inviteId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // PK Battle Supporters
      match /pk_supporters/{supporterId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Official Event Gifting Leaderboard
      match /event_leaderboard/{uid} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          (request.auth.uid == uid || isAdmin()) &&
          isValidEventLeaderboardEntry(request.resource.data, uid);
        allow update: if isAuthenticated() &&
          (
            isAdmin() ||
            (
              request.auth.uid == uid &&
              areImmutableFieldsUnchanged(['uid']) &&
              request.resource.data.totalDiamonds >= resource.data.get('totalDiamonds', 0) &&
              request.resource.data.giftCount >= resource.data.get('giftCount', 0)
            )
          ) &&
          isValidEventLeaderboardEntry(request.resource.data, uid);
        allow delete: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      }

      // Room Followers
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          (request.auth.uid == followerId || isAdmin()) &&
          request.resource.data.get('uid', followerId) == followerId;
        allow delete: if isAuthenticated() && (
          request.auth.uid == followerId ||
          isAdmin() ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('hostUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('hostId', '') == request.auth.uid
        );
      }
    }

    // ===============================================================
    // Matches & Dating Discovery
    // ===============================================================

    match /matches/{matchId} {
      allow read: if isAuthenticated() && resource.data.users.hasAny([request.auth.uid]);
      allow write: if isAuthenticated() && request.resource.data.users.hasAny([request.auth.uid]);

      // Direct match messages subcollection
      match /messages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // Chats & Direct Messaging
    // ===============================================================

    match /chats/{chatId} {
      allow read: if isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]);
      allow write: if isAuthenticated();

      match /messages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    match /message_requests/{reqId} {
      allow read: if isAuthenticated() && (
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('receiverId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('receiverId', '') == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('receiverId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // ===============================================================
    // Moments & Social Feed
    // ===============================================================

    match /moments/{momentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // Swipes, Intimacy Bonds & Proposals
    // ===============================================================

    match /swipes/{swipeId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /intimacy_bonds/{bondId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.data.user1Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid
      );
    }

    match /intimacy_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.senderUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      ) && areImmutableFieldsUnchanged(['senderUid', 'recipientUid']);
      allow delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /proposals/{proposalId} {
      allow read: if isAuthenticated() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid
      );
      allow write: if isAuthenticated() && (
        resource == null ||
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        request.resource.data.user1Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid
      );
    }

    // ===============================================================
    // Discovery & Intent Categories
    // ===============================================================

    match /intent_categories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /rooms/{roomId} {
        allow read, write: if isAuthenticated();

        match /members/{memberId} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // ===============================================================
    // Welcome Bonus Fraud Prevention: Claimed Devices & IPs
    // ===============================================================

    match /claimed_devices/{deviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /claimed_ips/{ip} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Global App Configuration & Broadcast Notifications
    // ===============================================================

    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // ===============================================================
    // Official Scheduled & Live Events
    // ===============================================================

    match /official_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.hostUid == request.auth.uid || isAdmin()) &&
        isValidOfficialEvent(request.resource.data);
      allow update: if isAuthenticated() &&
        (
          isAdmin() ||
          (
            resource.data.hostUid == request.auth.uid &&
            areImmutableFieldsUnchanged(['hostUid', 'createdAt'])
          )
        ) &&
        isValidOfficialEvent(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.hostUid == request.auth.uid || isAdmin());

      match /reminders/{uid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) &&
          isValidEventReminder(request.resource.data, uid);
        allow update: if isOwner(uid) &&
          areImmutableFieldsUnchanged(['uid']) &&
          isValidEventReminder(request.resource.data, uid);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ===============================================================
    // Default Deny Root Fallback
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
